    "@catppuccin/palette": "^1.8.0",
    "@webtui/css": "^0.1.10",
    "express": "^5.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
